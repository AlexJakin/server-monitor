{
  "name": "server-monitor",
  "displayName": "Server Monitor",
  "description": "实时查看本机或通过 OpenSSH 远程 Linux 服务器的 CPU、内存、每张显卡的运行进程与显存等配置与使用情况的仪表盘",
  "version": "0.5.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/server-monitor"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "monitor",
    "server",
    "ssh",
    "cpu",
    "gpu",
    "nvidia-smi",
    "trae"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:serverMonitor.openDashboard",
    "onCommand:serverMonitor.togglePause",
    "onCommand:serverMonitor.refresh",
    "onCommand:serverMonitor.switchDataSource",
    "onCommand:serverMonitor.connectSsh",
    "onCommand:serverMonitor.followTerminalSsh",
    "onCommand:serverMonitor.showEnvironment"
  ],
  "contributes": {
    "commands": [
      {
        "command": "serverMonitor.openDashboard",
        "title": "Server Monitor: 打开监控面板"
      },
      {
        "command": "serverMonitor.togglePause",
        "title": "Server Monitor: 暂停 / 继续刷新"
      },
      {
        "command": "serverMonitor.refresh",
        "title": "Server Monitor: 立即刷新"
      },
      {
        "command": "serverMonitor.switchDataSource",
        "title": "Server Monitor: 切换数据源"
      },
      {
        "command": "serverMonitor.connectSsh",
        "title": "Server Monitor: 连接远程服务器（SSH）"
      },
      {
        "command": "serverMonitor.followTerminalSsh",
        "title": "Server Monitor: 跟随当前终端的 SSH 会话"
      },
      {
        "command": "serverMonitor.showEnvironment",
        "title": "Server Monitor: 显示宿主环境信息"
      }
    ],
    "configuration": {
      "title": "Server Monitor",
      "properties": {
        "serverMonitor.host": {
          "type": "string",
          "default": "",
          "description": "面板顶部显示的名称。留空时分别显示 SSH 目标、本机计算机名或 gpu-01。"
        },
        "serverMonitor.refreshIntervalMs": {
          "type": "number",
          "enum": [1000, 2000, 5000, 10000],
          "default": 2000,
          "description": "指标刷新间隔（毫秒），与面板上的下拉选项一致。SSH 模式内部最小间隔为 1500ms。"
        },
        "serverMonitor.historyLength": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "趋势图保留的历史采样点数。"
        },
        "serverMonitor.dataSource": {
          "type": "string",
          "enum": [
            "local",
            "ssh",
            "demo"
          ],
          "default": "local",
          "description": "local = IDE 所在机器真实指标；ssh = 通过系统 OpenSSH 采集远程 Linux 服务器；demo = 模拟演示数据。"
        },
        "serverMonitor.sshHost": {
          "type": "string",
          "default": "",
          "description": "SSH 目标：user@host，或 ~/.ssh/config 里的 Host 别名。凭据只用本地 SSH 配置，切勿填写密码。"
        },
        "serverMonitor.sshArgs": {
          "type": "string",
          "default": "",
          "description": "附加 ssh 参数（空格分隔），例如 -p 2222 -i C:/keys/id_ed25519。含空格的路径请改用 ~/.ssh/config 别名。"
        },
        "serverMonitor.sshTimeoutMs": {
          "type": "number",
          "default": 12000,
          "minimum": 3000,
          "description": "单次 SSH 采集的超时时间（毫秒）。"
        },
        "serverMonitor.sshAutoDetect": {
          "type": "boolean",
          "default": true,
          "description": "自动识别集成终端进程树里的 ssh 会话，并让面板切换到该服务器。手动切换数据源后不再自动抢回。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node test/metrics.test.js",
    "package": "vsce package --out server-monitor.vsix",
    "publish:marketplace": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
